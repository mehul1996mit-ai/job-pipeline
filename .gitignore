__pycache__/
*.pyc
.env
# Generated per-job resume files: too many/large to keep in git history.
# Delivered instead via the workflow's uploaded artifact (see workflow yml).
data/resumes/
data/_livetest/
data/_demo/
streamlit_out.log
streamlit_err.log
# Regenerated on every Status-tab render (streamlit_app.py) — not source.
static/jt_status_data.json
# Career Agent's SQLite store: fully rebuildable from policy/company_allowlist.yaml
# + data/seen_jobs.json by re-running company_targeting.py — not source, and a
# binary file would just churn the git history on every run.
data/career_agent.sqlite3*
# Interview Prep Toolkit's SQLite store: fully rebuildable from
# resume_master.json + pasted JDs by re-running interview_prep.process_new_jd()
# — not source, same reasoning as career_agent.sqlite3 above.
data/interview_prep.sqlite3*

# watchdog auto-sync status (local runtime state, not code)
dashboard_sync.log
cron_delay_check.log
# A8's .eml fallback output — real outreach drafts or test artifacts, never source.
out/drafts/
